# Default: reuse Codex's ChatGPT sign-in; no OpenAI API key is needed.
SMART_ROUTER_AUTH_MODE=chatgpt
# Local token for /v1/route previews. It does not replace the ChatGPT credential.
SMART_ROUTER_API_KEY=
# These upstream/gateway settings are optional and used only in API mode.
SMART_ROUTER_UPSTREAM_BASE_URL=http://127.0.0.1:4001/v1
SMART_ROUTER_UPSTREAM_API_KEY=
# Only these directories may be inspected. An empty list disables local scanning.
SMART_ROUTER_PROJECT_ROOTS=[]
SMART_ROUTER_CLASSIFIER_ENABLED=false
SMART_ROUTER_CLASSIFIER_MODEL=gpt-6-luna
# Durable route identities survive restarts and inactivity (no transcript or credentials).
# SMART_ROUTER_ROUTE_STATE_FILE=/absolute/path/to/codex-smart-router/.run/routes.sqlite3
# TTL/capacity only bound the in-memory cache, not saved conversation routes.
SMART_ROUTER_ROUTE_TTL_SECONDS=7200
SMART_ROUTER_ROUTE_CAPACITY=4096
# Used only by LiteLLM, never by Codex or by the router frontend.
OPENAI_API_KEY=
LITELLM_MASTER_KEY=

